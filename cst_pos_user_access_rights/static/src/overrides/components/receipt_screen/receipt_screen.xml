<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">

        <!-- Desktop: Hide "New Order" button -->
        <xpath expr="//button[@name='done']" position="attributes">
            <attribute name="t-if">
                !splittedOrder and !hideNewOrderButton
            </attribute>
        </xpath>

        <!-- Mobile: Hide "New Order" button -->
        <xpath expr="//div[@id='action_btn_mobile']//div[@name='done']" position="attributes">
            <attribute name="t-if">
                !splittedOrder and !hideNewOrderButton
            </attribute>
        </xpath>
    </t>

</templates>
