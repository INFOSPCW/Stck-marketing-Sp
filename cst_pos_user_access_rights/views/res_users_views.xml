<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_inherit_pos" model="ir.ui.view">
        <field name="name">res.users.form.inherit.pos.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page name="pos_access_rights" string="Point of Sale Access Rights">

                    <group name="pos_order_management" string="Order &amp; Screen Controls">
                        <group>
                            <field name="hide_pos_new_order_button" widget="boolean_toggle"/>
                            <field name="hide_pos_delete_order_button" widget="boolean_toggle"/>
                            <field name="hide_pos_payment" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="hide_pos_customer_selection_button" widget="boolean_toggle"/>
                            <field name="hide_pos_actions_button" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group name="pos_product_info" string="Product Information">
                        <group>
                            <field name="hide_pos_action_product_info" widget="boolean_toggle"/>
                            <field name="hide_pos_finance_from_product_info"
                                   widget="boolean_toggle"
                                   invisible="hide_pos_action_product_info"/>
                        </group>
                    </group>

                    <group name="pos_numpad_controls" string="Numpad &amp; Pricing Controls">
                        <group>
                            <field name="hide_pos_numpad" widget="boolean_toggle"/>
                            <field name="disable_pos_change_price"
                                   widget="boolean_toggle"
                                   invisible="hide_pos_numpad"/>
                            <field name="disable_pos_qty"
                                   widget="boolean_toggle"
                                   invisible="hide_pos_numpad"/>
                        </group>
                        <group>
                            <field name="disable_pos_discount_button"
                                   widget="boolean_toggle"
                                   invisible="hide_pos_numpad"/>
                            <field name="disable_pos_remove_button"
                                   widget="boolean_toggle"
                                   invisible="hide_pos_numpad"/>
                            <field name="disable_pos_numpad_plus_minus"
                                   widget="boolean_toggle"
                                   invisible="hide_pos_numpad"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
