<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_create_lead_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.create.lead.form</field>
        <field name="model">helpdesk.ticket.create.lead</field>
        <field name="arch" type="xml">
            <form string="Create Lead from Ticket">
                <group>
                    <field name="ticket_id" readonly="1" />
                    <field name="team_id" />
                    <field name="user_id" />
                </group>
                <footer>
                    <button name="action_helpdesk_ticket_to_lead" type="object" string="Create Lead" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="helpdesk_ticket_create_lead_action" model="ir.actions.act_window">
        <field name="name">Create Lead</field>
        <field name="res_model">helpdesk.ticket.create.lead</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
