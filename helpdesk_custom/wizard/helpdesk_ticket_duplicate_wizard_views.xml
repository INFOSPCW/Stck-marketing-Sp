<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.duplicate.wizard.form</field>
        <field name="model">helpdesk.ticket.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Ticket">
                <group>
                    <field name="ticket_id" readonly="1" />
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="team_id" />
                    <field name="user_id" />
                    <field name="stage_id" />
                </group>
                <footer>
                    <button name="action_duplicate_ticket" type="object" string="Duplicate" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="helpdesk_ticket_duplicate_wizard_action" model="ir.actions.act_window">
        <field name="name">Duplicate Ticket</field>
        <field name="res_model">helpdesk.ticket.duplicate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_helpdesk_ticket" />
        <field name="binding_view_types">form</field>
    </record>
</odoo>
