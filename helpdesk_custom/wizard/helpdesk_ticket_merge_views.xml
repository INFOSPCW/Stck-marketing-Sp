<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_merge_form_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.merge.form</field>
        <field name="model">helpdesk.ticket.merge</field>
        <field name="arch" type="xml">
            <form string="Merge Tickets">
                <group>
                    <field name="ticket_ids" widget="many2many_tags" readonly="1" />
                    <field name="ticket_id" string="Master Ticket" domain="[('id','in',ticket_ids)]" />
                    <field name="action" />
                </group>
                <footer>
                    <button name="action_merge" type="object" string="Merge" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="helpdesk_ticket_merge_action" model="ir.actions.act_window">
        <field name="name">Merge Tickets</field>
        <field name="res_model">helpdesk.ticket.merge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_helpdesk_ticket" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
