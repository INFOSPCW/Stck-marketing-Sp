<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_helpdesk_timesheet_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="ticket">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Timesheet — Ticket
                            <span t-field="ticket.number" /> -
                            <span t-field="ticket.name" />
                        </h2>
                        <div class="row mt16">
                            <div class="col-4">
                                <strong>Team:</strong>
                                <span t-field="ticket.team_id" />
                            </div>
                            <div class="col-4">
                                <strong>Assigned to:</strong>
                                <span t-field="ticket.user_id" />
                            </div>
                            <div class="col-4">
                                <strong>Project:</strong>
                                <span t-field="ticket.project_id" />
                            </div>
                        </div>
                        <table class="table o_main_table mt16">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Employee</th>
                                    <th>Description</th>
                                    <th class="text-end">Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="ticket.timesheet_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.date" /></td>
                                        <td><span t-field="line.employee_id" /></td>
                                        <td><span t-field="line.name" /></td>
                                        <td class="text-end">
                                            <span t-field="line.unit_amount"
                                                  t-options='{"widget": "float_time"}' />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total</strong></td>
                                    <td class="text-end">
                                        <span t-field="ticket.total_hours"
                                              t-options='{"widget": "float_time"}' />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_helpdesk_timesheet" model="ir.actions.report">
        <field name="name">Timesheet</field>
        <field name="model">helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">helpdesk_custom.report_helpdesk_timesheet_document</field>
        <field name="report_file">helpdesk_custom.report_helpdesk_timesheet_document</field>
        <field name="binding_model_id" ref="model_helpdesk_ticket" />
        <field name="binding_type">report</field>
    </record>
</odoo>
