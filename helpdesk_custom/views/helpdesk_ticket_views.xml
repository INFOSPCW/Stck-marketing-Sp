<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Kanban view -->
    <record id="helpdesk_ticket_kanban_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" on_create="quick_create"
                    quick_create_view="helpdesk_custom.helpdesk_ticket_quick_create_view"
                    records_draggable="true">
                <field name="color" />
                <field name="stage_id" />
                <field name="user_id" />
                <field name="partner_id" />
                <field name="priority" />
                <field name="closed" />
                <field name="sla_expired" />
                <field name="tag_ids" />
                <field name="kanban_state" />
                <progressbar field="kanban_state"
                    colors='{"normal": "200", "done": "success", "blocked": "danger"}' />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''} oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="number" />
                                            -
                                            <field name="name" />
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="priority" widget="priority" />
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                                    <t t-if="record.partner_id.value">
                                        <div><field name="partner_id" /></div>
                                    </t>
                                    <t t-if="record.sla_expired.raw_value">
                                        <span class="text-bg-danger badge">SLA Expired</span>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="kanban_state" widget="state_selection" />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)"
                                             t-att-title="record.user_id.value"
                                             t-att-alt="record.user_id.value"
                                             class="oe_kanban_avatar o_image_24_cover" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Quick create view for kanban -->
    <record id="helpdesk_ticket_quick_create_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.quick_create</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="Ticket Title" required="True" />
                    <field name="partner_id" />
                    <field name="team_id" />
                    <field name="user_id" />
                    <field name="priority" widget="priority" />
                </group>
            </form>
        </field>
    </record>
    <!-- List view -->
    <record id="helpdesk_ticket_list_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" multi_edit="1" decoration-muted="closed == True">
                <field name="number" optional="show" />
                <field name="name" />
                <field name="partner_id" optional="show" />
                <field name="team_id" optional="show" />
                <field name="user_id" optional="show" />
                <field name="stage_id" optional="show" />
                <field name="priority" widget="priority" optional="show" />
                <field name="channel_id" optional="hide" />
                <field name="category_id" optional="show" />
                <field name="type_id" optional="hide" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide" />
                <field name="sla_deadline" optional="show" />
                <field name="sla_expired" optional="show" />
                <field name="last_stage_update" optional="hide" />
                <field name="closed" optional="hide" column_invisible="True" />
                <field name="kanban_state" widget="state_selection" optional="show" />
            </list>
        </field>
    </record>
    <!-- Form view -->
    <record id="helpdesk_ticket_form_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="stage_id" widget="statusbar" clickable="true"
                           options="{'fold_field': 'fold'}" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_related_tickets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-ticket"
                            invisible="related_ticket_count == 0">
                            <field name="related_ticket_count" widget="statinfo" string="Related" />
                        </button>
                        <button name="action_open_leads"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-phone"
                            invisible="lead_count == 0">
                            <field name="lead_count" widget="statinfo" string="Leads" />
                        </button>
                        <button name="action_view_sale_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-dollar"
                            invisible="so_count == 0">
                            <field name="so_count" widget="statinfo" string="Sales" />
                        </button>
                        <button name="action_view_timesheets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-clock-o"
                            invisible="not allow_timesheet or not total_hours">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_hours" widget="float_time" />
                                </span>
                                <span class="o_stat_text">Hours</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1" />&amp;nbsp;
                            <field name="name" placeholder="Ticket Title" />
                        </h1>
                    </div>
                    <group>
                        <group string="Ticket">
                            <field name="partner_id" />
                            <field name="partner_name" />
                            <field name="partner_email" />
                            <field name="partner_phone" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="channel_id" />
                            <field name="category_id" />
                            <field name="type_id" />
                            <field name="motive_id" />
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                            <field name="priority" widget="priority" />
                            <field name="kanban_state" widget="state_selection" />
                            <field name="color" widget="color_picker" />
                        </group>
                        <group string="Assignment">
                            <field name="team_id" />
                            <field name="user_id" />
                            <field name="last_stage_update" />
                            <field name="assigned_date" />
                            <field name="closed_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" />
                        </page>
                        <page string="SLA" name="sla" invisible="not team_sla">
                            <group>
                                <field name="sla_deadline" />
                                <field name="sla_expired" />
                                <field name="sla_fits" />
                            </group>
                            <field name="ticket_sla_ids" readonly="1">
                                <list>
                                    <field name="sla_id" />
                                    <field name="deadline" />
                                    <field name="state" />
                                    <field name="expired" />
                                </list>
                            </field>
                        </page>
                        <page string="Project" name="project" invisible="not project_domain_ids">
                            <group>
                                <field name="project_id" />
                                <field name="task_id" domain="project_domain_ids" />
                                <field name="milestone_id" invisible="not project_id" />
                            </group>
                        </page>
                        <page string="Timesheets" name="timesheets" invisible="not allow_timesheet">
                            <group>
                                <field name="planned_hours" />
                                <field name="progress" widget="progressbar" />
                                <field name="remaining_hours" widget="float_time" />
                            </group>
                            <field name="timesheet_ids">
                                <list editable="bottom">
                                    <field name="date" />
                                    <field name="employee_id" />
                                    <field name="name" />
                                    <field name="unit_amount" widget="float_time" />
                                </list>
                            </field>
                        </page>
                        <page string="Related Tickets" name="related_tickets">
                            <field name="related_ticket_ids" widget="many2many_tags" />
                        </page>
                        <page string="Rating" name="rating">
                            <group>
                                <field name="rating_status" />
                                <field name="positive_rate_percentage" />
                            </group>
                        </page>
                        <page string="Other" name="other">
                            <group>
                                <field name="product_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!-- Search view -->
    <record id="helpdesk_ticket_search_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="number" />
                <field name="name" />
                <field name="partner_id" />
                <field name="user_id" />
                <field name="team_id" />
                <field name="stage_id" />
                <field name="category_id" />
                <field name="type_id" />
                <field name="tag_ids" />
                <separator />
                <filter string="Open" name="filter_open" domain="[('closed','=',False)]" />
                <filter string="Closed" name="filter_closed" domain="[('closed','=',True)]" />
                <filter string="SLA Expired" name="filter_sla_expired" domain="[('sla_expired','=',True)]" />
                <filter string="High Priority" name="filter_high" domain="[('priority','in',['2','3'])]" />
                <filter string="Unattended" name="filter_unattended" domain="[('unattended','=',True)]" />
                <separator />
                <filter string="My Tickets" name="filter_my" domain="[('user_id','=',uid)]" />
                <filter string="Unassigned" name="filter_unassigned" domain="[('user_id','=',False)]" />
                <separator />
                <filter string="Today" name="filter_today"
                    domain="[('create_date','&gt;=',datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]" />
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}" />
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}" />
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'user_id'}" />
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}" />
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}" />
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}" />
                    <filter string="Channel" name="group_channel" context="{'group_by': 'channel_id'}" />
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date:week'}" />
                </group>
            </search>
        </field>
    </record>
    <!-- Main action -->
    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tickets found!</p>
            <p>Create your first ticket.</p>
        </field>
    </record>
    <!-- Action filtered to team -->
    <record id="helpdesk_ticket_action_team" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>
    <!-- My tickets -->
    <record id="helpdesk_ticket_action_my" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_my': 1, 'search_default_filter_open': 1}</field>
    </record>
    <!-- Action for mail activity tickets -->
    <record id="helpdesk_ticket_action_from_activity" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <!-- Generic main ticket action (used by sale order, product) -->
    <record id="helpdesk_ticket_action_main" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <!-- Action for tickets opened from a project -->
    <record id="ticket_action_from_project" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
