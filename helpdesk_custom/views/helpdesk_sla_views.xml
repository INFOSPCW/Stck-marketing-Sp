<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_sla_list_view" model="ir.ui.view">
        <field name="name">helpdesk.sla.list</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <list string="SLA Policies">
                <field name="name" />
                <field name="team_ids" widget="many2many_tags" />
                <field name="stage_id" />
                <field name="days" string="Days" />
                <field name="hours" string="Hours" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="helpdesk_sla_form_view" model="ir.ui.view">
        <field name="name">helpdesk.sla.form</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <form string="SLA Policy">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="team_ids" widget="many2many_tags" />
                            <field name="category_ids" widget="many2many_tags" />
                            <field name="tag_ids" widget="many2many_tags" />
                            <field name="stage_id" />
                            <field name="active" />
                        </group>
                        <group string="Time Limit">
                            <field name="days" />
                            <field name="hours" />
                        </group>
                    </group>
                    <group string="Ignore Stages">
                        <field name="ignore_stage_ids" widget="many2many_tags" nolabel="1" />
                    </group>
                    <group string="Filter Domain">
                        <field name="domain" nolabel="1" />
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="helpdesk_sla_action" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.sla</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
    <!-- SLA Report -->
    <record id="helpdesk_sla_report_list_view" model="ir.ui.view">
        <field name="name">helpdesk.sla.report.list</field>
        <field name="model">helpdesk.sla.report</field>
        <field name="arch" type="xml">
            <list string="SLA Report" create="false" edit="false" delete="false">
                <field name="ticket_id" />
                <field name="name" />
                <field name="team_id" />
                <field name="partner_id" />
                <field name="date" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="helpdesk_sla_report_search_view" model="ir.ui.view">
        <field name="name">helpdesk.sla.report.search</field>
        <field name="model">helpdesk.sla.report</field>
        <field name="arch" type="xml">
            <search string="SLA Report">
                <field name="ticket_id" />
                <field name="team_id" />
                <separator />
                <filter string="Expired" name="filter_expired" domain="[('state','=','expired')]" />
                <filter string="Ongoing" name="filter_ongoing" domain="[('state','=','on_going')]" />
                <filter string="Accomplished" name="filter_accomplished" domain="[('state','=','accomplished')]" />
                <separator />
                <filter string="Team" name="group_team" context="{'group_by': 'team_id'}" />
                <filter string="State" name="group_state" context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>
</odoo>
