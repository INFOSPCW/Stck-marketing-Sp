<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Project form: stat button for tickets -->
    <record id="project_project_helpdesk_form_inherit" model="ir.ui.view">
        <field name="name">project.project.helpdesk.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_helpdesk_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-ticket"
                    invisible="ticket_count == 0">
                    <field name="ticket_count" widget="statinfo" string="Tickets" />
                </button>
            </xpath>
        </field>
    </record>
    <!-- Task form: stat button for tickets -->
    <record id="project_task_helpdesk_form_inherit" model="ir.ui.view">
        <field name="name">project.task.helpdesk.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ticket"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-ticket"
                    invisible="ticket_count == 0">
                    <field name="ticket_count" widget="statinfo" string="Tickets" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
