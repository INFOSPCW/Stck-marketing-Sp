<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Stat button on task form ──────────────────────────────────────── -->
    <record id="view_task_form_inherit_timesheet_enhanced" model="ir.ui.view">
        <field name="name">project.task.form.timesheet_enhanced</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_timesheets" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        invisible="timesheet_count == 0">
                    <field name="timesheet_count" widget="statinfo" string="Timesheets"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ── Quick timesheet entry tab on task form ─────────────────────────── -->
    <record id="view_task_form_timesheet_tab" model="ir.ui.view">
        <field name="name">project.task.form.timesheet_tab</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <!-- Add begin/end columns to the inline timesheet list in task form -->
            <xpath expr="//field[@name='timesheet_ids']//field[@name='date']" position="after">
                <field name="time_start" widget="float_time" optional="show" string="Begin"/>
                <field name="time_stop" widget="float_time" optional="show" string="End"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']//field[@name='unit_amount']" position="after">
                <button name="action_timer_start" type="object" icon="fa-play"
                        title="Start Timer"
                        invisible="is_running"
                        class="btn-sm btn-success"/>
                <button name="action_timer_stop" type="object" icon="fa-stop"
                        title="Stop Timer"
                        invisible="not is_running"
                        class="btn-sm btn-danger"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='unit_amount']" position="after">
                <field name="is_running" column_invisible="True"/>
            </xpath>
        </field>
    </record>

</odoo>
