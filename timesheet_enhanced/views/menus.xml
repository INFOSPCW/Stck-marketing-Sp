<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the existing Timesheets menu rather than creating a parallel one.
         hr_timesheet already creates the root "Timesheets" app menu. -->

    <!-- ── Under My Timesheets (all timesheet users) ─────────────────────── -->
    <menuitem id="menu_timesheet_enhanced_my"
              name="My Timesheets (Enhanced)"
              parent="hr_timesheet.timesheet_menu_root"
              action="action_timesheet_enhanced_my"
              sequence="5"/>

    <menuitem id="menu_timesheet_enhanced_weekly"
              name="Weekly View"
              parent="hr_timesheet.timesheet_menu_root"
              action="action_timesheet_enhanced_weekly"
              sequence="6"/>

    <!-- ── Under All Timesheets (managers only) ───────────────────────────── -->
    <menuitem id="menu_timesheet_enhanced_all"
              name="All Timesheets (Enhanced)"
              parent="hr_timesheet.menu_hr_time_tracking"
              action="action_timesheet_enhanced_all"
              sequence="15"
              groups="hr_timesheet.group_hr_timesheet_approver"/>

</odoo>
