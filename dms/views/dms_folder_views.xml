<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dms_folder_list" model="ir.ui.view">
        <field name="name">dms.folder.list</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <list string="Folders" decoration-muted="active == False">
                <field name="complete_name"/>
                <field name="parent_folder_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="document_count" string="Documents"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dms_folder_form" model="ir.ui.view">
        <field name="name">dms.folder.form</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <form string="Folder">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="document_count" string="Documents" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Folder Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_folder_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this folder..."/>
                        </page>
                        <page string="Sub-folders">
                            <field name="child_folder_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="document_count" string="Documents"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dms_folder_kanban" model="ir.ui.view">
        <field name="name">dms.folder.kanban</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="document_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value}">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <span class="fa fa-folder-open me-1"/>
                                <field name="document_count"/> documents
                            </div>
                            <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                <div class="o_kanban_card_manage_section o_kanban_manage_view">
                                    <div>
                                        <a type="open">Edit</a>
                                    </div>
                                    <div>
                                        <a name="action_open_documents" type="object">Open Documents</a>
                                    </div>
                                </div>
                                <div class="o_kanban_card_manage_section o_kanban_manage_delete">
                                    <div>
                                        <a type="delete">Delete</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dms_folder_search" model="ir.ui.view">
        <field name="name">dms.folder.search</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <search string="Search Folders">
                <field name="complete_name" string="Folder"/>
                <field name="parent_folder_id"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_parent" string="Parent Folder"
                            context="{'group_by': 'parent_folder_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dms_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">dms.folder</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dms_folder_search"/>
        <field name="context">{'active_test': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first folder
            </p>
            <p>Organize your documents with a folder hierarchy.</p>
        </field>
    </record>

</odoo>
