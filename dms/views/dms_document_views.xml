<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Kanban view ───────────────────────────────────────────────────── -->
    <record id="view_dms_document_kanban" model="ir.ui.view">
        <field name="name">dms.document.kanban</field>
        <field name="model">dms.document</field>
        <field name="arch" type="xml">
            <kanban js_class="dms_document_kanban" default_group_by="" class="o_dms_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="mimetype"/>
                <field name="file_extension"/>
                <field name="human_size"/>
                <field name="is_favorited"/>
                <field name="is_locked"/>
                <field name="lock_uid"/>
                <field name="tag_ids"/>
                <field name="owner_id"/>
                <field name="folder_id"/>
                <field name="thumbnail"/>
                <field name="attachment_id"/>
                <field name="url"/>
                <field name="write_date"/>
                <templates>
                    <t t-name="card" class="dms_document_card o_dms_document_card">
                        <!-- File preview / icon area -->
                        <div class="o_dms_document_image">
                            <t t-if="record.thumbnail.raw_value">
                                <img t-att-src="'data:image/png;base64,' + record.thumbnail.raw_value"
                                     class="o_dms_document_thumbnail"/>
                            </t>
                            <t t-elif="record.type.raw_value == 'url'">
                                <span class="fa fa-globe fa-3x text-info"/>
                            </t>
                            <t t-else="">
                                <t t-set="ext" t-value="record.file_extension.raw_value"/>
                                <span t-attf-class="fa fa-3x #{ext == 'pdf' ? 'fa-file-pdf-o text-danger' : ext in ('doc','docx') ? 'fa-file-word-o text-primary' : ext in ('xls','xlsx') ? 'fa-file-excel-o text-success' : ext in ('ppt','pptx') ? 'fa-file-powerpoint-o text-warning' : ext in ('zip','rar','7z') ? 'fa-file-zip-o text-muted' : ext in ('jpg','jpeg','png','gif','webp') ? 'fa-file-image-o text-info' : 'fa-file-o text-muted'}"/>
                            </t>
                        </div>
                        <!-- Badges -->
                        <div class="o_dms_document_badges">
                            <span t-if="record.is_locked.raw_value" class="badge bg-warning text-dark"
                                  t-att-title="'Locked by ' + record.lock_uid.value">
                                <i class="fa fa-lock me-1"/>Locked
                            </span>
                        </div>
                        <!-- Card body -->
                        <div class="o_dms_document_body">
                            <div class="o_dms_document_title fw-bold text-truncate" t-att-title="record.name.value">
                                <field name="name"/>
                            </div>
                            <div class="o_dms_document_meta text-muted small">
                                <span t-if="record.human_size.value">
                                    <i class="fa fa-hdd-o me-1"/>
                                    <t t-out="record.human_size.value"/>
                                </span>
                                <span t-if="record.folder_id.value" class="ms-2">
                                    <i class="fa fa-folder-o me-1"/>
                                    <t t-out="record.folder_id.value"/>
                                </span>
                            </div>
                            <div class="o_dms_document_tags mt-1">
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>
                        </div>
                        <!-- Footer actions -->
                        <div class="o_dms_document_footer d-flex justify-content-between align-items-center">
                            <field name="owner_id" widget="many2one_avatar_user" options="{'display_avatar_name': False}"/>
                            <a name="action_toggle_favorite" type="object" class="o_dms_favorite">
                                <i t-attf-class="fa fa-star#{record.is_favorited.raw_value ? '' : '-o'} #{record.is_favorited.raw_value ? 'text-warning' : 'text-muted'}"/>
                            </a>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── List view ─────────────────────────────────────────────────────── -->
    <record id="view_dms_document_list" model="ir.ui.view">
        <field name="name">dms.document.list</field>
        <field name="model">dms.document</field>
        <field name="arch" type="xml">
            <list string="Documents" multi_edit="1" decoration-muted="active == False">
                <field name="name"/>
                <field name="type"/>
                <field name="folder_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="partner_id" optional="hide"/>
                <field name="mimetype" optional="hide"/>
                <field name="human_size" string="Size"/>
                <field name="write_date" string="Last Modified"/>
                <field name="is_favorited" widget="boolean_favorite" optional="show"/>
                <field name="is_locked" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────────────── -->
    <record id="view_dms_document_form" model="ir.ui.view">
        <field name="name">dms.document.form</field>
        <field name="model">dms.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_lock" string="Lock" type="object"
                            invisible="is_locked" class="btn-secondary"/>
                    <button name="action_unlock" string="Unlock" type="object"
                            invisible="not is_locked" class="btn-warning"/>
                    <button name="action_download" string="Download" type="object"
                            invisible="type == 'url'" class="btn-primary"/>
                    <button name="action_open_preview" string="Preview" type="object"
                            invisible="type == 'url' or not attachment_id" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_favorite" type="object"
                                class="oe_stat_button" icon="fa-star">
                            <field name="is_favorited" widget="boolean_favorite"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Locked"
                            bg_color="text-bg-warning"
                            invisible="not is_locked"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document Name"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="type" widget="radio"/>
                            <field name="folder_id"/>
                            <field name="url" invisible="type != 'url'" required="type == 'url'"/>
                            <field name="attachment_id" widget="binary"
                                   invisible="type != 'binary'"
                                   filename="file_name"/>
                            <field name="file_name" invisible="type != 'binary' or not attachment_id"/>
                            <field name="mimetype" invisible="type != 'binary' or not attachment_id"
                                   readonly="1"/>
                            <field name="human_size" string="Size" readonly="1"
                                   invisible="type != 'binary' or not attachment_id"/>
                            <field name="file_extension" readonly="1"
                                   invisible="type != 'binary' or not attachment_id"/>
                        </group>
                        <group string="Classification">
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="owner_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Related Record" invisible="not res_model">
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                        <field name="res_name" string="Record" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Add a description..."/>
                        </page>
                        <page string="Access Rights">
                            <group>
                                <field name="access_internal"/>
                                <field name="access_via_link"/>
                                <field name="lock_uid" readonly="1"/>
                            </group>
                            <field name="access_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                    <field name="expiration_date"/>
                                    <field name="last_access_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search view ───────────────────────────────────────────────────── -->
    <record id="view_dms_document_search" model="ir.ui.view">
        <field name="name">dms.document.search</field>
        <field name="model">dms.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name" string="Document"/>
                <field name="folder_id"/>
                <field name="tag_ids"/>
                <field name="owner_id"/>
                <field name="partner_id"/>
                <field name="index_content" string="Content"/>
                <separator/>
                <filter name="my_documents" string="My Documents"
                        domain="[('owner_id', '=', uid)]"/>
                <filter name="favorites" string="Starred"
                        domain="[('favorited_ids', 'in', [uid])]"/>
                <filter name="locked" string="Locked"
                        domain="[('lock_uid', '!=', False)]"/>
                <filter name="type_file" string="Files"
                        domain="[('type', '=', 'binary')]"/>
                <filter name="type_url" string="URLs"
                        domain="[('type', '=', 'url')]"/>
                <separator/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_folder" string="Folder"
                            context="{'group_by': 'folder_id'}"/>
                    <filter name="group_owner" string="Owner"
                            context="{'group_by': 'owner_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'type'}"/>
                    <filter name="group_mimetype" string="File Type"
                            context="{'group_by': 'mimetype'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'write_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────────────────────── -->
    <record id="action_dms_document_all" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">dms.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dms_document_search"/>
        <field name="context">{'search_default_type_file': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first document
            </p>
            <p>Store, tag and share files across your organization.</p>
        </field>
    </record>

    <record id="action_dms_document_mine" model="ir.actions.act_window">
        <field name="name">My Documents</field>
        <field name="res_model">dms.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dms_document_search"/>
        <field name="domain">[('owner_id', '=', uid)]</field>
        <field name="context">{'search_default_my_documents': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                You have no documents yet
            </p>
            <p>Upload a document to get started.</p>
        </field>
    </record>

    <record id="action_dms_document_favorites" model="ir.actions.act_window">
        <field name="name">Starred</field>
        <field name="res_model">dms.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dms_document_search"/>
        <field name="domain">[('favorited_ids', 'in', [uid])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No starred documents
            </p>
            <p>Star a document to find it quickly here.</p>
        </field>
    </record>

</odoo>
