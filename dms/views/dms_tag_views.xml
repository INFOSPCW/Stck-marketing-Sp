<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dms_tag_list" model="ir.ui.view">
        <field name="name">dms.tag.list</field>
        <field name="model">dms.tag</field>
        <field name="arch" type="xml">
            <list string="Document Tags" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="tooltip"/>
                <field name="document_count" string="Documents"/>
            </list>
        </field>
    </record>

    <record id="view_dms_tag_form" model="ir.ui.view">
        <field name="name">dms.tag.form</field>
        <field name="model">dms.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="tooltip"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dms_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">dms.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document tag
            </p>
            <p>Tags help you categorize and quickly find documents.</p>
        </field>
    </record>

</odoo>
