<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dms_upload_wizard_form" model="ir.ui.view">
        <field name="name">dms.upload.wizard.form</field>
        <field name="model">dms.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Documents">
                <sheet>
                    <group string="Settings">
                        <field name="folder_id"/>
                        <field name="owner_id"/>
                        <field name="access_internal"/>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </group>
                    <group string="Files">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="datas" widget="binary" filename="file_name"/>
                                <field name="file_name" column_invisible="True"/>
                                <field name="name" placeholder="Document name (optional)"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_upload" string="Upload" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dms_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Documents</field>
        <field name="res_model">dms.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
