<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id='res_config_settings_view_form_inherit_home_desk' model='ir.ui.view'>
        <field name='name'>res.config.settings.view.form.inherit.home.desk</field>
        <field name='model'>res.config.settings</field>
        <field name='inherit_id' ref='base_setup.res_config_settings_view_form'/>
        <field name='arch' type='xml'>
            <xpath expr='//app[@name="general_settings"]' position='inside'>
                <block title='Home Desk App' name='home_desk_app_setting'>
                    <setting string='Enterprise Version Detected'>
                        <field name='is_enterprise_installed' readonly='1'/>
                    </setting>
                    <setting string='Time Format' help='Choose 12-hour or 24-hour format for the Home Menu clock.'>
                        <field name='home_menu_time_format' widget='radio'/>
                    </setting>
                    <setting string='Clock Design' help='Choose the design for the Home Menu clock.'>
                        <field name='home_menu_clock_design' widget='radio'/>
                    </setting>
                    <setting string='Clock Color' help='Choose the color for the Home Menu clock.'>
                        <field name='color' widget='color_picker'/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
